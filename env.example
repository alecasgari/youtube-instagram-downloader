# HTTP server (inside Docker)
GIV_YTDLP_HOST=0.0.0.0
GIV_YTDLP_PORT=9876

# Optional API token for POST /download (n8n uses this path on the internal Docker network).
# Leave empty so n8n can call without a token — only expose UI paths publicly via reverse proxy.
GIV_YTDLP_TOKEN=

# Password for the web UI. Username + password required. Session cookie after login.
GIV_YTDLP_UI_USERNAME=alecasgari
GIV_YTDLP_UI_PASSWORD=change-me-to-a-strong-password
GIV_YTDLP_UI_SECRET=change-me-to-a-long-random-string

GIV_YTDLP_DATA_DIR=/data

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=givsharifi-videos
R2_PREFIX=library
R2_PUBLIC_BASE_URL=https://media.givsharifi.com

# Optional explicit cookies path inside container
# GIV_YTDLP_COOKIES_FILE=/data/cookies.txt
